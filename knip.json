{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "app.ts",
        "api.ts",
        "drivers/*/device.ts",
        "drivers/*/driver.ts",
        "flowCards/**/*.ts",
        "setup/**/*.ts",
        "scripts/**/*.mjs",
        "widgets/*/src/**/*.ts",
        "docs/.vitepress/**/*.{ts,mts}"
      ],
      "project": [
        "**/*.{ts,mts,cts}",
        "!packages/**"
      ]
    },
    "packages/contracts": {
      "entry": [
        "src/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/shared-domain": {
      "entry": [],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/settings-ui": {
      "entry": [
        "test/**/*.test.ts",
        "tests/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  },
  "vitest": {
    "config": [
      "vitest.config.mts",
      "vitest.config.unit.mts",
      "vitest.config.integration.mts",
      "vitest.config.e2e.mts",
      "vitest.config.tz.mts",
      "vitest.config.changed.mts"
    ]
  },
  "ignore": [
    "test/mocks/echarts-subpath-shim.ts",
    "test/mocks/homey.ts",
    "scripts/lib/change-impact.d.mts",
    "scripts/lib/run-parallel.d.mts",
    "scripts/with-validation-lock.d.mts"
  ],
  "ignoreDependencies": [
    "homey",
    "homey-api",
    "playwright",
    "lint-staged"
  ],
  "ignoreBinaries": [
    "homey"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  }
}
