{
  "name": "@pels/settings-ui",
  "private": true,
  "type": "module",
  "dependencies": {
    "@material/web": "^2.4.1",
    "preact": "^11.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run build:script && npm run build:tokens && npm run copy:public",
    "build:script": "esbuild src/script.ts --bundle --outfile=dist/script.js --format=iife --target=es2020 --minify --jsx=automatic --jsx-import-source=preact",
    "build:tokens": "style-dictionary build --config style-dictionary.config.mjs",
    "copy:public": "node scripts/copy-public.mjs",
    "lint": "eslint src test tests ../contracts/src ../shared-domain/src --max-warnings=0",
    "test": "npm run build && npm run test:unit && PELS_E2E_BUILD=0 npm run test:layout",
    "test:unit": "node ../../scripts/with-validation-lock.mjs settings-ui:test:unit -- vitest run --config vitest.config.ts",
    "test:layout": "npm run test:e2e -- tests/e2e/layout-regressions.spec.ts --project=chromium-mobile-width",
    "test:e2e": "node ../../scripts/with-validation-lock.mjs settings-ui:test:e2e -- playwright test --config playwright.config.ts",
    "test:e2e:capture": "node ../../scripts/with-validation-lock.mjs settings-ui:test:e2e:capture -- playwright test --config playwright.capture.config.ts"
  }
}
