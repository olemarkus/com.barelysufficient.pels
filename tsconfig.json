{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    // Scoped to THIS project on purpose. `packages/**` is excluded below and
    // `widgets/**` contributes only `*/src/api.ts`, so neither is ratcheted
    // here. They are ratcheted by their own projects instead:
    // packages/shared-domain/tsconfig.json and
    // packages/settings-ui/tsconfig.json (src-only) both set the flag and both
    // run in ci:checks. tsconfig.widgets.json is the one remaining rung.
    // tsconfig.tests.json extends this file and opts out explicitly, with its
    // reasoning there.
    "noUncheckedIndexedAccess": true,
    "outDir": ".homeybuild/",
    "isolatedModules": true
  },
  "include": [
    "app.ts",
    "api.ts",
    "drivers/**/*.ts",
    "flowCards/**/*.ts",
    "lib/**/*.ts",
    "setup/**/*.ts",
    "widgets/*/src/api.ts"
  ],
  "exclude": [
    "node_modules",
    ".claude",
    ".homeybuild",
    "settings/**",
    "packages/**",
    "test/**",
    "tests/**",
    "scripts/**"
  ]
}
