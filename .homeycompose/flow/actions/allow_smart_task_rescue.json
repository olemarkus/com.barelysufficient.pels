{
  "title": {
    "en": "Set what a smart task may do"
  },
  "titleFormatted": {
    "en": "Allow [[device]]'s smart task to [[property]] [[when]]"
  },
  "hint": {
    "en": "Choose when the task can go over today's budget, limit lower-priority devices, or hold power for an earlier start. Holding power leaves running devices on. The choice applies on the next plan refresh and stays until changed or the task is cleared."
  },
  "args": [
    {
      "name": "device",
      "type": "autocomplete",
      "title": {
        "en": "Device"
      },
      "placeholder": {
        "en": "Select smart-task device"
      }
    },
    {
      "name": "property",
      "type": "dropdown",
      "title": {
        "en": "Permission"
      },
      "values": [
        {
          "id": "exempt_from_budget",
          "label": {
            "en": "go over today's budget"
          }
        },
        {
          "id": "limit_lower_priority",
          "label": {
            "en": "limit lower-priority devices"
          }
        },
        {
          "id": "pause_lower_priority",
          "label": {
            "en": "reserve power so this task can start sooner"
          }
        }
      ]
    },
    {
      "name": "when",
      "type": "dropdown",
      "title": {
        "en": "When"
      },
      "values": [
        {
          "id": "never",
          "label": {
            "en": "at no time"
          }
        },
        {
          "id": "always",
          "label": {
            "en": "while it's scheduled to run"
          }
        }
      ]
    }
  ]
}
