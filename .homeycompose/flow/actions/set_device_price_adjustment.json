{
  "title": {
    "en": "Set price adjustment for device"
  },
  "titleFormatted": {
    "en": "Set the [[adjustment]] for [[device]] to [[amount]] °C"
  },
  "hint": {
    "en": "Saves how far PELS moves this device's temperature in cheap or expensive hours, the same setting as the device's Price response section. Use 0 to stop that adjustment. Needs Price-based control turned on for the device. Applied only while \"Respond to prices\" is on under Price-aware devices, and not while the device is set to \"Keep the new temperature\" or \"Save as current mode target\"."
  },
  "args": [
    {
      "name": "adjustment",
      "type": "dropdown",
      "title": {
        "en": "Adjustment"
      },
      "values": [
        {
          "id": "cheap_hour_boost",
          "label": {
            "en": "Cheap-hour boost"
          }
        },
        {
          "id": "expensive_hour_reduction",
          "label": {
            "en": "Expensive-hour reduction"
          }
        }
      ]
    },
    {
      "name": "device",
      "type": "autocomplete",
      "title": {
        "en": "Device"
      },
      "placeholder": {
        "en": "Select temperature device"
      }
    },
    {
      "name": "amount",
      "type": "number",
      "title": {
        "en": "Amount (°C)"
      },
      "placeholder": {
        "en": "0 - 20"
      },
      "min": 0,
      "max": 20,
      "step": 0.5
    }
  ],
  "id": "set_device_price_adjustment"
}
